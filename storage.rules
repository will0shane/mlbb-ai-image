rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Skin data (manifest + icons): readable by any signed-in user, writable by no one.
    // Uploads happen only through the admin SDK script.
    match /data/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
